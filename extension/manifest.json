{
  "manifest_version": 3,
  "name": "SOP Agent (Local)",
  "version": "0.1.0",
  "description": "Local-only SOP discovery agent with adaptive capture and offline mining.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOP Agent"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
